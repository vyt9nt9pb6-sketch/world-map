# 複製成 .env 後填入（.env 已被 .gitignore 排除）
AMAP_KEY=你的高德Web服務Key
PORT=8787
# 選填：只允許這些來源呼叫 /api（逗號分隔），例如 https://worldmap.example.com
ALLOWED_ORIGINS=

# ───── v2 選填功能（沒設定就自動停用，不影響其他功能）─────
# 天地圖衛星圖層：瀏覽器端 tk（天地圖後台選「瀏覽器端」，網域白名單填你的網站網域）
TIANDITU_TK=
# 3D 地圖：高德「Web端(JS API)」key 與安全密鑰（安全密鑰只留在伺服器，由 /_AMapService 代理補上）
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
# 信箱登入（收藏跨裝置同步）：寄信服務。provider = brevo | resend | cloudflare
MAIL_PROVIDER=
MAIL_FROM=
MAIL_FROM_NAME=World Map
BREVO_API_KEY=
RESEND_API_KEY=
# 每日最多寄幾封驗證碼（預設 200）；AUTH_SECRET 可省略（會自動產生並存在 KV）
MAIL_DAILY_LIMIT=200
AUTH_SECRET=
# 注意：Node 本機伺服器沒有 KV，登入／收藏用記憶體儲存，重啟即清空；正式環境請用 Cloudflare Worker（WM_KV）。
